<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all in-app styling; the XML theme only needs to be edge-to-edge friendly
         and provide a sensible window background before the first frame. -->
    <style name="Theme.Fasting" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
